# Host that runs the inference services (what clients connect to).
# Leave as 127.0.0.1 for a single-machine setup, or set the LAN/VPN address of
# the machine that will serve the gateway.
INFERENCE_HOST=127.0.0.1

# Gateway listen port and bind address.
INFERENCE_PORT=8080
INFERENCE_BIND=0.0.0.0

# Where models, binaries, logs and caches live on the serving machine.
# Windows example: C:\local-inference
# Linux example:   /srv/inference
INFERENCE_ROOT=C:\local-inference

# File holding the gateway bearer token (created by scripts/new-key.*).
# Defaults to %USERPROFILE%\.config\inference-secrets\gateway.key on Windows
# and ~/.config/inference-secrets/gateway.key elsewhere.
GATEWAY_KEY_FILE=

# Optional: TypeSafe (Jev) API key for the /v1/classify route.
# Can also live in <secrets-dir>/typesafe.key.
TYPESAFE_API_KEY=

# Optional: Hugging Face token, only needed for gated repositories.
HF_TOKEN=
